# Copy to .env (repo root) and paste your FREE API keys.
#   cp config/.env.example .env
# Get keys free at the key_page for each provider in
# config/free-llm-providers.json. NEVER commit .env.
#
# Pick ONE provider to start (e.g. Gemini or Groq — no card needed):

GEMINI_API_KEY=
GROQ_API_KEY=
COHERE_API_KEY=
HF_TOKEN=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
CEREBRAS_API_KEY=
DASHSCOPE_API_KEY=
CLOUDFLARE_API_KEY=

# FreeLLMAPI local gateway (after: curl -fsSL https://freellmapi.co/install.sh | bash)
FREELLMAPI_API_KEY=

# Modal (free credit): run `modal setup` instead of a key.

# --- Telegram note storage (scripts/telegram_store.py) -------------------
# Get the token from @BotFather (/mybots -> API Token). Treat it as a
# password: anyone with it controls the bot. Rotate it if it leaks.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
