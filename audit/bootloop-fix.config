# Source rebuild input, NOT a flashable file.
# Confirm these resolve in the final generated .config and link into Image.
# Supplied kernel has CONFIG_F2FS_FS disabled; recovery logs show /data is F2FS.
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_ENCRYPTION=y
# Encryption/inline-crypto compatibility must be checked against this source's
# fs/f2fs/Kconfig, vendor fstab and vendor crypto implementation. Unknown symbols
# can be dropped by olddefconfig. Do not disable encryption or format userdata.
